# Local development template. Replace placeholders locally; never commit real values.
NODE_ENV=development
PORT=3000

# The active production data architecture is Supabase PostgreSQL and REST.
# DATABASE_URL is not required by the active Supabase runtime. Do not point the
# production application at the historical MySQL adapter.

# Supabase project URL and anon key are public; service-role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=product-images

# Optional owner identity and server-only integrations.
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional browser map integration. This key is public; restrict it to your origins.
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# Optional Vite aliases for the public Supabase values above.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Explicit opt-in for the non-production Supabase product/inventory seed.
# SUPABASE_SEED_ALLOW_WRITE=true
# SUPABASE_DEV_SELLER_ID=APPROVED_SELLER_PROFILE_UUID

# Legacy MySQL seed variables. Do not use these with the active Supabase data.
# SEED_SUPERADMIN_1_EMAIL=
# SEED_SUPERADMIN_1_PASSWORD=
# SEED_SUPERADMIN_2_EMAIL=
# SEED_SUPERADMIN_2_PASSWORD=
# SEED_OFFICER_EMAIL=
# SEED_OFFICER_PASSWORD=
# SEED_BUYER_EMAIL=
# SEED_BUYER_PASSWORD=
# SEED_SELLER_EMAIL=
# SEED_SELLER_PASSWORD=

# Legacy `seed:superadmins` only; prefer `seed:defaults`.
# SUPERADMIN_JOAN_PASSWORD=
# SUPERADMIN_EROL_PASSWORD=
