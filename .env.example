# Copy to .env.local and replace placeholders. Never commit real credentials.
NODE_ENV=development
PORT=3000
# Production must be HTTPS origin used for Supabase email redirects.
APP_URL=http://localhost:3000

# PostgreSQL — keep these separate. Never point MIGRATION_/SEED_ at production.
DATABASE_URL=postgresql://APP_USER:REPLACE_ME@HOST:5432/DATABASE
MIGRATION_DATABASE_URL=postgresql://MIGRATION_USER:REPLACE_ME@127.0.0.1:5432/DATABASE
SEED_DATABASE_URL=postgresql://SEED_USER:REPLACE_ME@127.0.0.1:5432/DATABASE

# Local disposable harness only (scripts/db-test). Must be localhost.
# TEST_DATABASE_URL=postgresql://agricoop_login:agricoop_test_password@127.0.0.1:55432/agricoop_test

# Supabase (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key

# Supabase (server-only)
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_STORAGE_BUCKET=product-images

# Seed scripts (local only). Require AGRICOOP_SEED_TARGET=local.
# AGRICOOP_SEED_TARGET=local
# SEED_SUPERADMIN_1_EMAIL=
# SEED_SUPERADMIN_1_PASSWORD=
# SEED_SUPERADMIN_2_EMAIL=
# SEED_SUPERADMIN_2_PASSWORD=
# SEED_OFFICER_EMAIL=
# SEED_OFFICER_PASSWORD=
# SEED_BUYER_EMAIL=
# SEED_BUYER_PASSWORD=
# SEED_SELLER_EMAIL=
# SEED_SELLER_PASSWORD=

# Authenticated Playwright E2E against production (e2e/auth-payment-system.spec.ts).
# Set locally or in CI secrets — never commit real values; never print them.
# QA_BUYER_EMAIL=
# QA_BUYER_PASSWORD=
# QA_SELLER_EMAIL=
# QA_SELLER_PASSWORD=
# QA_ADMIN_EMAIL=
# QA_ADMIN_PASSWORD=

# Optional diagnostics (never log secret values)
AGRICOOP_AUTH_DIAGNOSTICS=false
VITE_AUTH_DIAGNOSTICS=false

# Optional legacy Manus/Forge (public if VITE_*; restrict by domain or leave unset)
# VITE_APP_ID=
# VITE_FRONTEND_FORGE_API_URL=
# VITE_FRONTEND_FORGE_API_KEY=
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
# JWT_SECRET=
# OAUTH_SERVER_URL=
